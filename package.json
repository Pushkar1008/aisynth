{
  "name": "aisynth",
  "productName": "AISynth",
  "version": "2.0.0",
  "description": "AISynth (Ollama Nexus): chat, agents, workflows, swarm what-if analysis and image generation on top of local Ollama.",
  "private": true,
  "homepage": "./",
  "main": "electron/main.js",
  "author": "Pushkar",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.63.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "mock": "node tools/mock-server.js",
    "test:e2e": "node tools/run-e2e.js"
  },
  "build": {
    "appId": "com.aisynth.app",
    "productName": "AISynth",
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
